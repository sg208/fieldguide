    "prettier": "^3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "^4.156.2"
